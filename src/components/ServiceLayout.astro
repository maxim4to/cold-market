---
import Base from '../layouts/Base.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import ContactCta from './ContactCta.astro';
import Icon from './Icon.astro';
import { company } from '../lib/site';
import { abs } from '../lib/url';

interface Props {
  url: string;
  title: string;
  description: string;
  h1: string;
  lead: string;
  cta?: string;
  ctaText?: string;
  serviceType: string;
  image?: string;
}
const { url, title, description, h1, lead, cta = 'Позвонить', ctaText, serviceType, image } = Astro.props;
const phone = company.phones[0];
const jsonld = [{
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: h1,
  serviceType,
  areaServed: { '@type': 'AdministrativeArea', name: 'Тверская область' },
  provider: { '@id': abs('/', Astro.site) + '#org' },
}];
---
<Base title={title} description={description} canonical={url} jsonld={jsonld} image={image}>
  <div class="border-b border-line bg-gradient-to-b from-ice to-white">
    <div class="container-x py-5"><Breadcrumbs items={[{ url, name: h1 }]} /></div>
    <div class="container-x pb-10 pt-4">
      <p class="eyebrow">Сервисная служба</p>
      <h1 class="mt-2 text-3xl font-extrabold tracking-tight md:text-5xl">{h1}</h1>
      <p class="mt-4 max-w-2xl text-base text-ink-soft md:text-lg">{lead}</p>
      <div class="mt-6 grid grid-cols-2 gap-2 sm:flex sm:gap-3">
        <a href={phone.href} data-goal="click_phone" class="btn-primary whitespace-nowrap px-3 text-[13px] sm:px-6 sm:text-sm"><Icon name="phone" class="h-4 w-4 shrink-0" />{cta}</a>
        <a href={company.whatsapp.href} data-goal="click_whatsapp" target="_blank" rel="noopener" class="btn-wa whitespace-nowrap px-3 text-[13px] sm:px-6 sm:text-sm"><Icon name="whatsapp" class="h-4 w-4 shrink-0" />Написать в WhatsApp</a>
      </div>
    </div>
  </div>

  <div class="container-x py-10">
    <slot />
    <div class="mt-14">
      <ContactCta title={cta} text={ctaText} />
    </div>
  </div>
</Base>
