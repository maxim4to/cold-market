---
import { localImage, allLabels, displayPrice, priceNumber, framedStyle, specFields, noBreakSlash, type Product } from '../lib/catalog';
import { u } from '../lib/url';
import Icon from './Icon.astro';
interface Props { product: Product; index?: number }
const { product: p, index } = Astro.props;
const img = localImage(p.images[0]?.thumb || p.images[0]?.medium, 'thumb');
const labels = allLabels(p);
const frame = framedStyle(p.images[0]?.full);
// on narrow cards the price may wrap before «руб.», but never inside the number
const nbsp = (s: string) => s.replace(/(\d) (?=\d)/g, '$1\u00a0');
const keySpecs = specFields(p.specs.flatMap((g) => g.fields)).filter((f) => !/^(Модель|Производитель|Страна)/.test(f.name)).slice(0, 3);
---
<a href={u(p.url)} data-product data-i={index} data-brand={(p.manufacturer || '').trim().toLowerCase()} data-price={priceNumber(p.price) && priceNumber(p.price)! > 1 ? priceNumber(p.price) : ''} data-stock={labels.includes('В наличии') ? '1' : undefined} data-sale={labels.includes('Sale') ? '1' : undefined} class="group card relative flex flex-col overflow-hidden transition hover:border-brand/60 hover:shadow-lg hover:shadow-brand/10">
  {labels.length > 0 && (
    <div class="absolute left-3 top-3 z-10 flex gap-1">
      {labels.map((l) => <span class={`rounded-md px-2 py-0.5 text-[11px] font-bold text-white ${l === 'Sale' ? 'bg-sale' : 'bg-ok'}`}>{l === 'Sale' ? 'Скидка' : l}</span>)}
    </div>
  )}
  <div class="relative grid aspect-square place-items-center overflow-hidden bg-white">
    {img && frame && <img src={u(img)} alt={p.name} loading="lazy" decoding="async" style={frame} class="absolute max-w-none transition group-hover:scale-[1.03]" />}
    {img && !frame && <img src={u(img)} alt={p.name} loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-contain p-4 transition group-hover:scale-[1.03]" />}
    {!img && <Icon name="box" class="h-12 w-12 text-line" />}
  </div>
  <div class="flex flex-1 flex-col gap-2 border-t border-line p-4">
    {p.manufacturer && <span class="text-[11px] font-bold uppercase tracking-wider text-muted">{p.manufacturer}</span>}
    <span class="line-clamp-4 hyphens-auto text-sm font-semibold leading-snug [overflow-wrap:anywhere] group-hover:text-brand-deep sm:line-clamp-3 sm:text-[15px]">{noBreakSlash(p.name)}</span>
    {keySpecs.length > 0 && (
      <ul class="space-y-0.5 text-xs text-muted">
        {keySpecs.map((s) => <li class="line-clamp-2 [overflow-wrap:anywhere]">{s.name}: <span class="font-semibold text-ink-soft">{s.value}</span></li>)}
      </ul>
    )}
    <div class="mt-auto flex items-end justify-between gap-2 pt-2">
      <span class="min-w-0">
        {p.old_price && <span class="block text-xs text-muted line-through">{nbsp(p.old_price)}</span>}
        <span class={`font-extrabold tracking-tight ${displayPrice(p.price) === p.price ? "text-base sm:text-lg" : "text-[13px] text-brand-deep sm:text-sm"}`}>{nbsp(displayPrice(p.price))}</span>
      </span>
      <span class="hidden h-9 w-9 shrink-0 place-items-center rounded-lg bg-ice text-brand-deep transition group-hover:bg-brand-deep group-hover:text-white sm:grid"><Icon name="arrow" class="h-4 w-4" /></span>
    </div>
  </div>
</a>
