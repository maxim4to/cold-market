---
import Icon from './Icon.astro';
---
<dialog id="lightbox" class="fixed inset-0 m-0 h-dvh max-h-none w-screen max-w-none overflow-hidden bg-ink p-0 backdrop:bg-ink" aria-label="Просмотр изображения">
  <div data-backdrop class="absolute inset-0 grid place-items-center px-3 pt-16 pb-6 sm:px-10">
    <img alt="" class="h-full w-full touch-pinch-zoom object-contain" />
  </div>
  <button type="button" data-close class="absolute top-3 right-3 grid h-11 w-11 place-items-center rounded-full bg-white/10 text-white hover:bg-white/20" aria-label="Закрыть"><Icon name="close" class="h-6 w-6" /></button>
</dialog>
<script is:inline>
  // Links marked data-lightbox open their image full-screen instead of navigating to the raw file
  (function () {
    var d = document.getElementById('lightbox');
    if (!d || !d.showModal) return;
    var img = d.querySelector('img');
    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('a[data-lightbox]');
      if (!a || e.button || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      var src = a.querySelector('img');
      img.src = a.href;
      img.alt = src ? src.alt : '';
      d.showModal();
    });
    // the image itself doesn't close the dialog, so it can be pinch-zoomed on phones
    d.addEventListener('click', function (e) {
      if (e.target === d || e.target.hasAttribute('data-backdrop') || e.target.closest('[data-close]')) d.close();
    });
    d.addEventListener('close', function () { img.removeAttribute('src'); });
  })();
</script>
