---
import { localImage, framedStyle, productsLabel } from '../lib/catalog';
import { u } from '../lib/url';
import Icon from './Icon.astro';
interface Props { url: string; name: string; image: string | null; count?: number; ribbon?: string }
const { url, name, image, count, ribbon } = Astro.props;
const img = localImage(image);
const frame = framedStyle(image, 4 / 3);
---
<a href={u(url)} class="group card relative flex flex-col overflow-hidden transition hover:-translate-y-0.5 hover:border-brand/60 hover:shadow-lg hover:shadow-brand/10">
  {ribbon && (
    <span class="pointer-events-none absolute top-[18px] -left-[34px] z-10 w-[130px] -rotate-45 bg-[#d62828] py-[3px] text-center shadow-md shadow-black/20">
      <span class="block border-y border-dashed border-white/70 py-[2px] text-[11px] leading-none font-extrabold tracking-[0.22em] text-white">{ribbon}</span>
    </span>
  )}
  <div class="relative grid aspect-[4/3] place-items-center overflow-hidden bg-gradient-to-b from-frost to-ice">
    {img && frame && <img src={u(img)} alt={name} loading="lazy" decoding="async" style={frame} class="absolute max-w-none mix-blend-multiply transition group-hover:scale-[1.03]" />}
    {img && !frame && <img src={u(img)} alt={name} loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-contain p-4 mix-blend-multiply transition group-hover:scale-[1.03]" />}
    {!img && <Icon name="snow" class="h-12 w-12 text-brand/40" />}
  </div>
  <div class="flex flex-1 flex-col justify-end border-t border-line px-3 py-3 sm:px-4">
    <span class="block hyphens-auto text-[15px] font-bold leading-snug break-words">{name}</span>
    <span class="mt-0.5 flex items-center justify-between gap-2">
      <span class="text-xs text-muted">{count ? productsLabel(count) : null}</span>
      <Icon name="arrow" class="h-4 w-4 shrink-0 text-brand-deep transition group-hover:translate-x-0.5" />
    </span>
  </div>
</a>
