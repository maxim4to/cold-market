---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import MapBlock from '../components/MapBlock.astro';
import Icon from '../components/Icon.astro';
import { company } from '../lib/site';
---
<Base title="Контакты — ХолодМаркет, Тверь, ул. Плеханова, 53" description={`Контакты ХолодМаркет в Твери: ${company.address.full}. Телефон ${company.phones[0].label}, WhatsApp, Telegram. Режим работы: пн–чт 9:00–17:00, пт 9:00–16:30.`} canonical="/kontakty.html">
  <div class="border-b border-line bg-gradient-to-b from-ice to-white">
    <div class="container-x py-5"><Breadcrumbs items={[{ url: '/kontakty.html', name: 'Контакты' }]} /></div>
    <div class="container-x pb-10 pt-4">
      <p class="eyebrow">{company.legalName}</p>
      <h1 class="mt-2 text-3xl font-extrabold tracking-tight md:text-5xl">Контакты</h1>
    </div>
  </div>
  <div class="container-x grid gap-8 py-10 lg:grid-cols-[380px_minmax(0,1fr)]">
    <div class="space-y-4">
      <div class="card p-6">
        <p class="eyebrow">Телефоны</p>
        {company.phones.map((p) => <a href={p.href} data-goal="click_phone" class="mt-2 flex items-center gap-2 text-xl font-extrabold tracking-tight hover:text-brand-deep"><Icon name="phone" class="h-5 w-5 text-brand" />{p.label}</a>)}
      </div>
      <div class="card p-6">
        <p class="eyebrow">Мессенджеры и почта</p>
        <div class="mt-3 grid gap-2">
          <a href={company.whatsapp.href} data-goal="click_whatsapp" target="_blank" rel="noopener" class="btn-wa justify-start"><Icon name="whatsapp" class="h-4 w-4" /><span>WhatsApp <span class="whitespace-nowrap">{company.whatsapp.label}</span></span></a>
          <a href={company.telegram.href} data-goal="click_telegram" target="_blank" rel="noopener" class="btn-tg justify-start"><Icon name="telegram" class="h-4 w-4" />Telegram {company.telegram.label}</a>
          <a href={`mailto:${company.email}`} data-goal="click_email" class="btn-ghost justify-start"><Icon name="mail" class="h-4 w-4" />{company.email}</a>
        </div>
      </div>
      <div class="card p-6">
        <p class="eyebrow">Адрес и режим работы</p>
        <p class="mt-2 flex gap-2 font-semibold"><Icon name="pin" class="mt-0.5 h-5 w-5 shrink-0 text-brand" />{company.address.full}</p>
        <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
          {company.hours.map((h) => <><dt class="text-muted">{h.days}</dt><dd class="font-semibold">{h.time}</dd></>)}
        </dl>
      </div>
    </div>
    <MapBlock />
  </div>
</Base>
