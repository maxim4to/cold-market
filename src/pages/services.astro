---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactCta from '../components/ContactCta.astro';
import Icon from '../components/Icon.astro';
import ServiceMedia from '../components/ServiceMedia.astro';
import { services } from '../lib/site';
import { localImage } from '../lib/catalog';
import { u } from '../lib/url';
---
<Base title="Услуги: проектирование, монтаж, обслуживание и ремонт оборудования в Твери — ХолодМаркет" description="Проектирование торговых объектов, монтаж, техническое обслуживание и ремонт холодильного и технологического оборудования в Твери и Тверской области." canonical="/services.html">
  <div class="border-b border-line bg-gradient-to-b from-ice to-white">
    <div class="container-x py-5"><Breadcrumbs items={[{ url: '/services.html', name: 'Услуги' }]} /></div>
    <div class="container-x pb-10 pt-4">
      <p class="eyebrow">Сервисная служба</p>
      <h1 class="mt-2 text-3xl font-extrabold tracking-tight md:text-5xl">Услуги</h1>
      <p class="mt-3 max-w-2xl text-ink-soft">Полный цикл: от проекта торгового зала до монтажа, регулярного обслуживания и ремонта.</p>
    </div>
  </div>
  <div class="container-x py-10">
    <div class="grid gap-4 sm:grid-cols-2">
      {services.map((s) => (
        <a href={u(s.href)} class="group card flex overflow-hidden transition hover:border-brand/60 hover:shadow-lg hover:shadow-brand/10">
          <ServiceMedia image={s.image} video={(s as { video?: string }).video} alt={s.title} class="w-32 shrink-0 self-stretch sm:w-44" />
          <div class="flex flex-col p-5">
            <span class="text-lg font-extrabold group-hover:text-brand-deep">{s.title}</span>
            <span class="mt-1 text-sm text-ink-soft">{s.short}</span>
            <span class="mt-auto flex items-center gap-1 pt-3 text-sm font-semibold text-brand-deep">Подробнее <Icon name="arrow" class="h-4 w-4" /></span>
          </div>
        </a>
      ))}
    </div>
    <div class="mt-10"><ContactCta title="Вызвать специалиста" text="Выезд по Твери и Тверской области. Расскажите, что случилось с оборудованием, — подскажем стоимость и сроки." /></div>
  </div>
</Base>
