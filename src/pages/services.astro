---
import { u, abs } from '../lib/url';
// The services overview was dropped: the home page lists all four services. Old links land there.
const target = u('/#services');
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={abs('/', Astro.site)} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <title>Услуги — ХолодМаркет</title>
  </head>
  <body>
    <a href={target}>Услуги ХолодМаркет</a>
  </body>
</html>
